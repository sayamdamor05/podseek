# Copy this file to .env.local for local development.
# On Netlify / Vercel: set these in the Environment Variables dashboard.

# Google Gemini API key — required for semantic embeddings and segmentation
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string — optional; falls back to in-memory mode if not set
DATABASE_URL=postgresql://user:password@localhost:5432/podseek

# Render backend URL — set this on Netlify ONLY (leave blank for local dev)
# Example: https://podseek-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=
